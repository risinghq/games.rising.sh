{
  "name": "games.rising.sh",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/risinghq/games.rising.sh.git"
  },
  "workspaces": [
    "apps/*",
    "games/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxfmt --check .",
    "fix": "oxfmt .",
    "check": "bun run lint && bun test ./tools && bun run --filter '*' check",
    "gate": "bun run --filter '*' gate",
    "deploy": "bun tools/deploy.ts"
  },
  "devDependencies": {
    "oxfmt": "^0.75.0",
    "wrangler": "^4.155.0"
  }
}
