{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rising-games",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "games.rising.sh", "custom_domain": true }],
}
