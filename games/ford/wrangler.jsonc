{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "games-ford",
  "compatibility_date": "2026-10-01",
  // `bun run stage` copies dist/ to .deploy/ford/, so the asset paths carry the
  // /ford/ prefix the route serves them under.
  "assets": { "directory": "./.deploy" },
  "routes": [
    { "pattern": "games.rising.sh/ford", "zone_name": "rising.sh" },
    { "pattern": "games.rising.sh/ford/*", "zone_name": "rising.sh" },
  ],
}
