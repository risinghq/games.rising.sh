{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "games-border",
  "compatibility_date": "2026-10-01",
  // `bun run stage` copies dist/ to .deploy/border/, so the asset paths carry the
  // /border/ prefix the route serves them under.
  "assets": { "directory": "./.deploy" },
  "routes": [
    { "pattern": "games.rising.sh/border", "zone_name": "rising.sh" },
    { "pattern": "games.rising.sh/border/*", "zone_name": "rising.sh" },
  ],
}
