{
  "name": "emberwick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && vite dist",
    "build": "rm -rf dist && bun ./build.ts",
    "stage": "rm -rf .deploy && mkdir .deploy && cp -r dist .deploy/emberwick",
    "deploy": "bun run build && bun run stage && wrangler deploy"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  }
}
