{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "games-emberwick",
  "compatibility_date": "2026-10-01",
  // `bun run stage` copies dist/ to .deploy/emberwick/, so the page is
  // served under the /emberwick/ prefix the route matches.
  "assets": { "directory": "./.deploy" },
  "routes": [
    { "pattern": "games.rising.sh/emberwick", "zone_name": "rising.sh" },
    {
      "pattern": "games.rising.sh/emberwick/*",
      "zone_name": "rising.sh",
    },
  ],
}
