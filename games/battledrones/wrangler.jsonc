{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "games-battledrones",
  "compatibility_date": "2026-10-01",
  // `bun run stage` copies dist/ to .deploy/battledrones/, so the asset paths
  // carry the /battledrones/ prefix the route serves them under.
  "assets": { "directory": "./.deploy" },
  "routes": [
    { "pattern": "games.rising.sh/battledrones", "zone_name": "rising.sh" },
    { "pattern": "games.rising.sh/battledrones/*", "zone_name": "rising.sh" }
  ]
}
