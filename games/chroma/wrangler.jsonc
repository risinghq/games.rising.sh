{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "games-chroma",
  "compatibility_date": "2026-10-01",
  // `bun run stage` copies dist/ to .deploy/chroma/, so the asset paths carry
  // the /chroma/ prefix the route serves them under.
  "assets": { "directory": "./.deploy" },
  "routes": [
    { "pattern": "games.rising.sh/chroma", "zone_name": "rising.sh" },
    { "pattern": "games.rising.sh/chroma/*", "zone_name": "rising.sh" },
  ],
}
