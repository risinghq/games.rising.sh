{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "games-reef",
  "compatibility_date": "2026-10-01",
  // `bun run stage` copies dist/ to .deploy/reef/, so the asset paths carry the
  // /reef/ prefix the route serves them under.
  "assets": { "directory": "./.deploy" },
  "routes": [
    { "pattern": "games.rising.sh/reef", "zone_name": "rising.sh" },
    { "pattern": "games.rising.sh/reef/*", "zone_name": "rising.sh" },
  ],
}
